@page "/journal-list"
@using MyJournal.Services
@using MyJournal.Entities
@using MyJournal.Models.Display
@inject JournalService JournalService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<div class="journal-list-header">
    <div class="header-content">
        <h1>Journal Entries</h1>
        <p>Browse through all your journal entries</p>
    </div>
    <div class="header-actions">
        <MudButton Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    StartIcon="@Icons.Material.Filled.Add"
                    Href="/journal">
            New Entry
        </MudButton>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <MudPaper Elevation="2" Class="loading-card">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <h3>Loading journal entries...</h3>
            <p>Please wait while we fetch your entries</p>
        </MudPaper>
    </div>
}
else if (entries?.Any() == true)
{
    <div class="entries-container">
        @foreach (var entry in entries)
        {
            <MudPaper Elevation="1" Class="entry-item">
                <div class="entry-content">
                    <div class="entry-left">
                        <div class="entry-date-section">
                            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Color="Color.Default" />
                            <span class="entry-date">@entry.FormattedDate</span>
                            @if (entry.IsToday)
                            {
                                <MudChip T="bool" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">Today</MudChip>
                            }
                        </div>
                        
                        @if (entry.PrimaryMood != null)
                        {
                            <div class="mood-section">
                                <MudIcon Icon="@GetMoodIcon(entry.PrimaryMood.Icon)" Size="Size.Small" Class="mood-emoji" />
                                <span class="mood-name">@entry.PrimaryMood.Name</span>
                            </div>
                        }

                        <div class="content-preview">
                            <p>@entry.PlainTextPreview</p>
                        </div>

                        @if (entry.Tags.Any())
                        {
                            <div class="tags-section">
                                @foreach (var tag in entry.Tags.Take(5))
                                {
                                    <span class="tag-chip">@tag.Name</span>
                                }
                                @if (entry.Tags.Count > 5)
                                {
                                    <span class="tag-more">+@(entry.Tags.Count - 5)</span>
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="entry-right">
                        <div class="entry-meta">
                            @if (entry.WasEdited)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" />
                            }
                            <span class="word-count">@entry.WordCount words</span>
                        </div>
                        
                        <div class="entry-actions">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       Href="@($"/view-entry/{entry.Id}")">
                                View
                            </MudButton>
                        </div>
                    </div>
                </div>
            </MudPaper>
        }
    </div>

    <!-- MudBlazor Pagination -->
    <div class="pagination-container">
        <MudPaper Elevation="1" Class="pagination-card">
            <MudPagination Count="@totalPages" 
                          Selected="@currentPage" 
                          ShowFirstButton="true"
                          ShowLastButton="true"
                          ShowPreviousButton="true"
                          ShowNextButton="true"
                          SelectedChanged="OnPageChanged"
                          Class="pagination-component" />
            
            <div class="pagination-info">
                Showing @((currentPage - 1) * pageSize + 1) to @(Math.Min(currentPage * pageSize, totalEntries)) of @totalEntries entries
            </div>
        </MudPaper>
    </div>
}
else
{
    <div class="empty-state">
        <MudPaper Elevation="2" Class="empty-card">
            <div class="empty-icon">
                <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Color="Color.Default" />
            </div>
            <h2>No Journal Entries</h2>
            <p>You haven't created any journal entries yet. Start writing to see your entries here.</p>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/journal">
                Create Your First Entry
            </MudButton>
        </MudPaper>
    </div>
}

@code {
    private List<JournalEntryDisplayModel> entries = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private int totalEntries = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        try
        {
            isLoading = true;
            var result = await JournalService.GetEntriesWithCountAsync(
                DateTime.Today.AddYears(-10), // Go back 10 years to get all entries
                DateTime.Today.AddDays(1),    // Include today
                page: currentPage, 
                pageSize: pageSize);

            if (result.Success)
            {
                entries = result.Data.Entries;
                totalEntries = result.Data.TotalCount;
                totalPages = (int)Math.Ceiling((double)totalEntries / pageSize);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to load entries", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading entries: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        if (newPage != currentPage)
        {
            currentPage = newPage;
            await LoadEntries();
        }
    }

    private string GetMoodIcon(string? iconString)
    {
        if (string.IsNullOrEmpty(iconString))
            return Icons.Material.Filled.Face;

        // Handle both old Unicode emojis and new MudBlazor icon references
        if (iconString.StartsWith("@Icons.Material.Filled."))
        {
            var iconName = iconString.Replace("@Icons.Material.Filled.", "");
            return iconName switch
            {
                "SentimentVerySatisfied" => Icons.Material.Filled.SentimentVerySatisfied,
                "Celebration" => Icons.Material.Filled.Celebration,
                "Spa" => Icons.Material.Filled.Spa,
                "VolunteerActivism" => Icons.Material.Filled.VolunteerActivism,
                "FitnessCenter" => Icons.Material.Filled.FitnessCenter,
                "Water" => Icons.Material.Filled.Water,
                "Psychology" => Icons.Material.Filled.Psychology,
                "TravelExplore" => Icons.Material.Filled.TravelExplore,
                "PhotoCamera" => Icons.Material.Filled.PhotoCamera,
                "HourglassEmpty" => Icons.Material.Filled.HourglassEmpty,
                "SentimentVeryDissatisfied" => Icons.Material.Filled.SentimentVeryDissatisfied,
                "MoodBad" => Icons.Material.Filled.MoodBad,
                "PsychologyAlt" => Icons.Material.Filled.PsychologyAlt,
                "PersonOff" => Icons.Material.Filled.PersonOff,
                "HealthAndSafety" => Icons.Material.Filled.HealthAndSafety,
                _ => Icons.Material.Filled.Face
            };
        }

        // Old Unicode emojis - map to appropriate MudBlazor icons
        return iconString switch
        {
            "😊" => Icons.Material.Filled.SentimentVerySatisfied,
            "🎉" => Icons.Material.Filled.Celebration,
            "😌" => Icons.Material.Filled.Spa,
            "🙏" => Icons.Material.Filled.VolunteerActivism,
            "💪" => Icons.Material.Filled.FitnessCenter,
            "🤔" => Icons.Material.Filled.Psychology,
            "🧐" => Icons.Material.Filled.TravelExplore,
            "📷" => Icons.Material.Filled.PhotoCamera,
            "😑" => Icons.Material.Filled.HourglassEmpty,
            "😢" => Icons.Material.Filled.SentimentVeryDissatisfied,
            "😠" => Icons.Material.Filled.MoodBad,
            "😰" => Icons.Material.Filled.PsychologyAlt,
            "😔" => Icons.Material.Filled.PersonOff,
            "😟" => Icons.Material.Filled.HealthAndSafety,
            _ => Icons.Material.Filled.Face
        };
    }
}

