@page "/streaks"
@using MyJournal.Services
@using MyJournal.Entities
@inject StreakService StreakService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="text-center mb-4">
    <h2> Streak Tracking</h2>
    <p class="text-muted">Track your journaling consistency and build lasting habits</p>
</div>

@if (isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudPaper Elevation="2" Class="pa-6 text-center">
            <MudProgressCircular Indeterminate="true" />
            <p class="mt-3">Loading streak data...</p>
        </MudPaper>
    </MudContainer>
}
else if (stats != null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <!-- Current Streak Card -->
        <MudPaper Elevation="3" Class="pa-4 mb-4">
            <div class="text-center">
                <MudText Typo="Typo.h3" Color="Color.Primary">
                     @stats.CurrentStreak
                </MudText>
                <MudText Typo="Typo.h6" Class="mb-2">
                    Current Day Streak
                </MudText>

                @if (stats.CurrentStreak == 0)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        Start your streak today! Write your first journal entry.
                    </MudAlert>
                }
                else if (stats.CurrentStreak == 1)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-2">
                        Great start! Keep it going tomorrow!
                    </MudAlert>
                }
                else if (stats.CurrentStreak < 7)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2">
                        You're on a roll! @stats.CurrentStreak days in a row!
                    </MudAlert>
                }
                else if (stats.CurrentStreak < 30)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2">
                        Amazing! @stats.CurrentStreak days of consistent journaling!
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2">
                        🏆 Incredible! @stats.CurrentStreak days - you're a journaling master!
                    </MudAlert>
                }
            </div>
        </MudPaper>

        <!-- Statistics Grid -->
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Warning" Class="mb-2" />
                    <MudText Typo="Typo.h4">@stats.LongestStreak</MudText>
                    <MudText Typo="Typo.body2">Longest Streak</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    <MudText Typo="Typo.h4">@stats.TotalJournalDays</MudText>
                    <MudText Typo="Typo.body2">Total Entries</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" Class="mb-2" />
                    <MudText Typo="Typo.h4">@stats.JournalingFrequency:F1%</MudText>
                    <MudText Typo="Typo.body2">Consistency</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Error" Class="mb-2" />
                    <MudText Typo="Typo.h4">@stats.TotalMissedDays</MudText>
                    <MudText Typo="Typo.body2">Missed Days</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Action Buttons -->
        <div class="text-center mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       Href="/journal">
                Write Today's Entry
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       Href="/analytics">
                View Analytics
            </MudButton>
        </div>
    </MudContainer>
}

@code {
    private StreakStatistics? stats;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStreakData();
    }

    private async Task LoadStreakData()
    {
        try
        {
            stats = await StreakService.GetStreakStatisticsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading streak data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}