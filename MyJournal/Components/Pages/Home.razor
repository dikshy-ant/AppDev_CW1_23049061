@page "/"
@using MyJournal.Services
@using MyJournal.Entities
@using MyJournal.Models.Display
@inject JournalService JournalService
@inject ISnackbar Snackbar
@inject PinProtectionService PinProtectionService


<div class="text-center mb-4">
    <h2>My Journal</h2>
</div>

<div class="d-flex justify-space-between align-center mb-3">
    <MudButton Variant="Variant.Outlined" 
                Color="Color.Primary" 
                StartIcon="@Icons.Material.Filled.Refresh"
                OnClick="LoadLatestEntries"
                Disabled="isLoading">
        Refresh
    </MudButton>
    
    <MudButton Variant="Variant.Filled" 
                Color="Color.Primary" 
                StartIcon="@Icons.Material.Filled.Add"
                Href="/journal">
        New Entry
    </MudButton>
</div>

@if (isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudPaper Elevation="2" Class="pa-6 text-center">
            <MudProgressCircular Indeterminate="true" />
            <p class="mt-3">Loading your journal entries...</p>
        </MudPaper>
    </MudContainer>
}
else if (entries?.Any() == true)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        @foreach (var entry in entries)
        {
            <MudPaper Elevation="3" Class="pa-4 mb-4 entry-card">
                <!-- Entry Header -->
                <div class="d-flex justify-space-between align-start mb-3">
                    <div class="flex-grow-1">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Primary" />
                            <span class="entry-date">@entry.FormattedDate</span>
                            @if (entry.IsToday)
                            {
                                <MudChip T="bool" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Today</MudChip>
                            }
                        </div>
                        
                        @if (entry.PrimaryMood != null)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <span class="mood-display">@entry.PrimaryMood.Icon @entry.PrimaryMood.Name</span>
                            </div>
                        }
                    </div>
                    
                    <div class="d-flex align-center gap-2">
                        @if (entry.WasEdited)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" />
                        }
                        <span class="word-count">@entry.WordCount words</span>
                    </div>
                </div>

                <!-- Entry Content Preview -->
                <div class="entry-content-preview mb-3">
                    <p class="ma-0">@entry.PlainTextPreview</p>
                </div>

                <!-- Tags -->
                @if (entry.Tags.Any())
                {
                    <div class="mb-3">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var tag in entry.Tags.Take(5))
                            {
                                <span class="tag-chip">@tag.Name</span>
                            }
                            @if (entry.Tags.Count > 5)
                            {
                                <span class="tag-chip more-tags">+@(entry.Tags.Count - 5)</span>
                            }
                        </div>
                    </div>
                }

                <!-- Action Button -->
                <div class="d-flex justify-end">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Href="@($"/view-entry?date={entry.Date:yyyy-MM-dd}")">
                        Read More
                    </MudButton>
                </div>
            </MudPaper>
        }

        <!-- Pagination Controls -->
        @if (totalPages > 1)
        {
            <div class="mt-4">
                <MudPaper Elevation="1" Class="pa-3">
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.KeyboardArrowLeft"
                                       OnClick="PreviousPage"
                                       Disabled="currentPage == 1 || isLoading">
                                Previous
                            </MudButton>
                            
                            <div class="d-flex align-center gap-1">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                    {
                                        <MudButton Variant="@((i == currentPage) ? Variant.Filled : Variant.Outlined)"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="() => GoToPage(i)"
                                                   Disabled="isLoading">
                                            @i
                                        </MudButton>
                                    }
                                    else if (i == currentPage - 2 || i == currentPage + 2)
                                    {
                                        <span class="pagination-dots">...</span>
                                    }
                                }
                            </div>
                            
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       EndIcon="@Icons.Material.Filled.KeyboardArrowRight"
                                       OnClick="NextPage"
                                       Disabled="currentPage == totalPages || isLoading">
                                Next
                            </MudButton>
                        </div>
                        
                        <div class="text-caption">
                            Page @currentPage of @totalPages (@entries.Count entries)
                        </div>
                    </div>
                </MudPaper>
            </div>
        }

        @if (entries.Count == pageSize && totalPages == currentPage + 1)
        {
            <div class="text-center mt-4">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           OnClick="NextPage"
                           Disabled="isLoading">
                    Load More Entries
                </MudButton>
            </div>
        }
        else if (totalPages == 1 && entries.Count > 0)
        {
            <div class="text-center mt-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/calendar">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="mr-2" />
                    View All Entries in Calendar
                </MudButton>
            </div>
        }
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
        <MudPaper Elevation="2" Class="pa-6 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Class="mb-3" />
            <h4>No journal entries yet</h4>
            <p class="text-muted">Start your journaling journey by creating your first entry!</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/journal">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
                Create Your First Entry
            </MudButton>
        </MudPaper>
    </MudContainer>
}

@code {
    private List<JournalEntryDisplayModel> entries = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;
    private int totalEntries = 0;

    protected override async Task OnInitializedAsync()
    {
        // Check PIN protection before loading content
        await PinProtectionService.RequireAuthenticationAsync();
        
        await LoadLatestEntries();
    }

    private async Task LoadLatestEntries()
    {
        try
        {
            isLoading = true;
            var result = await JournalService.GetEntriesWithCountAsync(DateTime.Today.AddDays(-30), DateTime.Today, page: currentPage, pageSize: pageSize);

            if (result.Success)
            {
                entries = result.Data.Entries;
                totalEntries = result.Data.TotalCount;
                totalPages = (int)Math.Ceiling((double)totalEntries / pageSize);
                
                Console.WriteLine($"Loaded {entries.Count} entries for page {currentPage} of {totalPages} (total: {totalEntries})");
                
                // Debug: Log entry details
                foreach (var entry in entries)
                {
                    Console.WriteLine($"Entry: {entry.Date} - {entry.ContentPreview?.Substring(0, Math.Min(50, entry.ContentPreview?.Length ?? 0))}");
                }
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to load entries", Severity.Error);
                Console.WriteLine($"Error loading entries: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading entries: {ex.Message}", Severity.Error);
            Console.WriteLine($"Exception: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        
        currentPage = page;
        await LoadLatestEntries();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            await GoToPage(currentPage + 1);
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            await GoToPage(currentPage - 1);
        }
    }

    private Color GetMoodColor(MoodCategory category) => category switch
    {
        MoodCategory.Positive => Color.Success,
        MoodCategory.Neutral => Color.Warning,
        MoodCategory.Negative => Color.Error,
        _ => Color.Default
    };

    private string GetMoodColorClass(MoodCategory category) => category switch
    {
        MoodCategory.Positive => "success",
        MoodCategory.Neutral => "warning", 
        MoodCategory.Negative => "error",
        _ => "default"
    };
}

<style>
.chip {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 16px;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 2px;
}

.chip-small {
    padding: 2px 8px;
    font-size: 0.7rem;
}

.chip-primary {
    background-color: var(--mud-palette-primary);
    color: white;
}

.chip-secondary {
    background-color: var(--mud-palette-secondary);
    color: white;
}

.chip-success {
    background-color: var(--mud-palette-success);
    color: white;
}

.chip-warning {
    background-color: var(--mud-palette-warning);
    color: white;
}

.chip-error {
    background-color: var(--mud-palette-error);
    color: white;
}

.chip-default {
    background-color: var(--mud-palette-grey-default);
    color: var(--mud-palette-text-primary);
}

.chip-outlined {
    background-color: transparent;
    border: 1px solid currentColor;
}

.chip-filled {
    background-color: currentColor;
    color: white;
}

.chip-text {
    background-color: transparent;
    color: var(--mud-palette-text-secondary);
}

.pagination-dots {
    padding: 0 8px;
    color: var(--mud-palette-text-secondary);
    font-weight: 500;
    align-self: center;
}

/* Improved Card Styles */
.entry-card {
    border: 1px solid var(--mud-palette-grey-default);
    background: var(--mud-palette-surface);
}


.entry-date {
    font-weight: 600;
    color: var(--mud-palette-primary);
    font-size: 0.95rem;
}

.mood-display {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--mud-palette-text-primary);
}

.entry-content-preview {
    color: var(--mud-palette-text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
    border-left: 3px solid var(--mud-palette-grey-light);
    padding-left: 12px;
    margin: 16px 0;
}

.word-count {
    font-size: 0.85rem;
    color: var(--mud-palette-text-disabled);
    font-weight: 500;
}

.tag-chip {
    display: inline-block;
    padding: 4px 10px;
    background-color: var(--mud-palette-grey-light);
    color: var(--mud-palette-text-secondary);
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--mud-palette-grey-default);
    transition: all 0.2s ease;
}

.tag-chip:hover {
    background-color: var(--mud-palette-primary);
    color: white;
    transform: scale(1.05);
}

.tag-chip.more-tags {
    background-color: var(--mud-palette-secondary);
    color: white;
    border-color: var(--mud-palette-secondary);
}
</style>
