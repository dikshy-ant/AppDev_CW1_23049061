@page "/"
@using MyJournal.Services
@using MyJournal.Entities
@using MyJournal.Models.Display
@inject JournalService JournalService
@inject ISnackbar Snackbar
@inject PinProtectionService PinProtectionService

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">Welcome Back</h1>
            <p class="hero-subtitle">Your personal space for thoughts and reflections</p>
        </div>
        <div class="hero-actions">
            <MudButton Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Size="Size.Large"
                        StartIcon="@Icons.Material.Filled.Add"
                        Href="/journal"
                        Class="hero-button">
                New Entry
            </MudButton>
            <MudButton Variant="Variant.Outlined" 
                        Color="Color.Secondary" 
                        Size="Size.Large"
                        StartIcon="@Icons.Material.Filled.Refresh"
                        OnClick="LoadLatestEntries"
                        Disabled="isLoading"
                        Class="hero-button">
                Refresh
            </MudButton>
        </div>
    </div>
</div>

<!-- Content Section -->
<div class="content-section">
    @if (isLoading)
    {
        <div class="loading-container">
            <MudPaper Elevation="3" Class="loading-card">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <h3>Loading your journal entries...</h3>
                <p>Please wait while we fetch your memories</p>
            </MudPaper>
        </div>
    }
    else if (entries?.Any() == true)
    {
        <div class="entries-header">
            <h2>Recent Entries</h2>
            <MudButton Variant="Variant.Text" 
                        Color="Color.Secondary" 
                        EndIcon="@Icons.Material.Filled.CalendarViewMonth"
                        Href="/journal-list"
                        Class="view-all-btn">
                View All
            </MudButton>
        </div>

        <div class="entries-grid">
            @foreach (var entry in entries)
            {
                <MudPaper Elevation="2" Class="entry-card-modern">
                    <!-- Entry Header -->
                    <div class="entry-header">
                        <div class="entry-date-section">
                            <div class="entry-date-icon">
                                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" />
                            </div>
                            <div class="entry-date-info">
                                <div class="entry-date">@entry.FormattedDate</div>
                                @if (entry.IsToday)
                                {
                                    <MudChip T="bool" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Today</MudChip>
                                }
                            </div>
                        </div>
                        
                        <div class="entry-meta">
                            @if (entry.WasEdited)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" Class="meta-icon" />
                            }
                            <span class="word-count">@entry.WordCount words</span>
                        </div>
                    </div>

                    <!-- Mood Display -->
                    @if (entry.PrimaryMood != null)
                    {
                        <div class="mood-section">
                            <div class="mood-indicator">
                                <span class="mood-emoji">@entry.PrimaryMood.Icon</span>
                                <span class="mood-name">@entry.PrimaryMood.Name</span>
                            </div>
                        </div>
                    }

                    <!-- Content Preview -->
                    <div class="content-preview">
                        <p>@entry.PlainTextPreview</p>
                    </div>

                    <!-- Tags -->
                    @if (entry.Tags.Any())
                    {
                        <div class="tags-section">
                            <div class="tags-container">
                                @foreach (var tag in entry.Tags.Take(3))
                                {
                                    <span class="tag-modern">@tag.Name</span>
                                }
                                @if (entry.Tags.Count > 3)
                                {
                                    <span class="tag-more">+@(entry.Tags.Count - 3)</span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Action Button -->
                    <div class="entry-actions">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Primary" 
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Href="@($"/view-entry/{entry.Id}")"
                                   Class="read-more-btn">
                            View More
                        </MudButton>
                    </div>
                </MudPaper>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <MudPaper Elevation="3" Class="empty-card">
                <div class="empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Large" Color="Color.Primary" />
                </div>
                <h2>Start Your Journal Journey</h2>
                <p>Every great story begins with a single word. Create your first entry and start documenting your thoughts, memories, and experiences.</p>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="/journal"
                           Class="empty-action-btn">
                    Create Your First Entry
                </MudButton>
            </MudPaper>
        </div>
    }
</div>

@code {
    private List<JournalEntryDisplayModel> entries = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Check PIN protection before loading content
        await PinProtectionService.RequireAuthenticationAsync();
        
        await LoadLatestEntries();
    }

    private async Task LoadLatestEntries()
    {
        try
        {
            isLoading = true;
            var result = await JournalService.GetEntriesWithCountAsync(DateTime.Today.AddDays(-30), DateTime.Today, page: 1, pageSize: 5);

            if (result.Success)
            {
                entries = result.Data.Entries.Take(5).ToList();
                Console.WriteLine($"Loaded {entries.Count} entries");
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to load entries", Severity.Error);
                Console.WriteLine($"Error loading entries: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading entries: {ex.Message}", Severity.Error);
            Console.WriteLine($"Exception: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Color GetMoodColor(MoodCategory category) => category switch
    {
        MoodCategory.Positive => Color.Success,
        MoodCategory.Neutral => Color.Warning,
        MoodCategory.Negative => Color.Error,
        _ => Color.Default
    };

    private string GetMoodColorClass(MoodCategory category) => category switch
    {
        MoodCategory.Positive => "success",
        MoodCategory.Neutral => "warning", 
        MoodCategory.Negative => "error",
        _ => "default"
    };
}

