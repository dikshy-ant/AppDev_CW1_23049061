<div class="top-row ps-3 navbar navbar-light">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="sidebar-toggle" @onclick="ToggleSidebar">
                <span class="toggle-icon">@(_isCollapsed ? "☰" : "✕")</span>
            </button>
            <a class="navbar-brand" href="">
                <span class="brand-icon">📔</span> MyJournal
            </a>
        </div>
    </div>
</div>

<div class="nav-scrollable @(_isCollapsed ? "collapsed" : "")" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon home-icon" aria-hidden="true"></span> 
                <span class="nav-text">Home</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="journal">
                <span class="nav-icon journal-icon" aria-hidden="true"></span> 
                <span class="nav-text">New Entry</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calendar">
                <span class="nav-icon calendar-icon" aria-hidden="true"></span> 
                <span class="nav-text">Calendar</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="analytics">
                <span class="nav-icon analytics-icon" aria-hidden="true"></span> 
                <span class="nav-text">Analytics</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="streaks">
                <span class="nav-icon streak-icon" aria-hidden="true"></span> 
                <span class="nav-text">Streaks</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="search">
                <span class="nav-icon search-icon" aria-hidden="true"></span> 
                <span class="nav-text">Search</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="nav-icon settings-icon" aria-hidden="true"></span> 
                <span class="nav-text">Settings</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool _isCollapsed = false;

    private void ToggleSidebar()
    {
        _isCollapsed = !_isCollapsed;
    }
}
