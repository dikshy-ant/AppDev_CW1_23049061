@inherits LayoutComponentBase
@implements IDisposable
@using MyJournal.Services
@inject PinProtectionService PinProtectionService
@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (isAuthenticated)
{
    <CascadingValue Value="true">
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4">
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </CascadingValue>
}
else
{
    <div class="pin-auth-container">
        @Body
    </div>
}

<style>
    .pin-auth-container {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #1a1a1a;
    }

    .page {
        display: flex;
        flex-direction: row;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .sidebar {
        width: 250px;
        height: 100vh;
        background-color: #f8f9fa;
        border-right: 1px solid #dee2e6;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        flex-shrink: 0;
    }

    .sidebar::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Opera */
    }

    main {
        flex: 1;
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
    }

    .top-row {
        height: 0;
        display: flex;
        align-items: center;
        padding: 0;
        border-bottom: none;
    }

    .content {
        padding: 1rem;
    }
</style>

@code {
    private bool isAuthenticated = false;
    private bool isLoading = true;
    private System.Threading.Timer? _authCheckTimer;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationState();
        // Start a timer to periodically check authentication state
        _authCheckTimer = new System.Threading.Timer(async _ => await CheckAuthenticationState(), 
            null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthenticationState();
    }

    public void Dispose()
    {
        _authCheckTimer?.Dispose();
    }

    private async Task CheckAuthenticationState()
    {
        bool wasAuthenticated = isAuthenticated;
        
        try
        {
            isAuthenticated = await PinProtectionService.IsAuthenticatedAsync();
            
            // Only redirect if not authenticated and not already on PIN page
            if (!isAuthenticated && !NavigationManager.Uri.Contains("pin-verify"))
            {
                NavigationManager.NavigateTo("/pin-verify", forceLoad: true);
            }
            
            // If authentication state changed, update UI
            if (wasAuthenticated != isAuthenticated)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
            isAuthenticated = false;
        }
    }
}
