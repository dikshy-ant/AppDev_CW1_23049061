@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar @(_isSidebarCollapsed ? "collapsed" : "")">
        <NavMenu @ref="navMenu" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">MyJournal</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private NavMenu? navMenu;
    private bool _isSidebarCollapsed = false;
}
